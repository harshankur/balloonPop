// balloonpop.harshankur.com on Cloudflare Workers: this folder is the site, served as static assets
// with no Worker code (.assetsignore lists what is not published). Cloudflare's Git integration runs
// `npx wrangler deploy` on every push to master.
{
  "name": "balloonpop",
  "compatibility_date": "2026-10-01",
  // No usage reports from the deploy tool to Cloudflare.
  "send_metrics": false,
  // Served only at balloonpop.harshankur.com, a custom domain attached to the Worker in the
  // Cloudflare dashboard. The workers.dev address served a copy of the site that search engines
  // could index, so it is off, and so are the preview addresses of uploaded versions.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "."
  }
}
